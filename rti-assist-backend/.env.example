# ==============================================================================
# RTI ASSIST BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Frontend connects to http://localhost:8000/api by default)
PORT=8000

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API KEY
# ------------------------------------------------------------------------------
# Get your free key from: https://aistudio.google.com/app/apikey
# Paste your Gemini key below:
GEMINI_API_KEY=

# Preferred Gemini Model (Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# JWT Secret for Token Verification
JWT_SECRET=rti_assist_jwt_dev_secret_key_2026

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Zero-setup persistent embedded SQL database (H2 in PostgreSQL mode)
# stored at ./data/rti_assist_db.mv.db.
# To switch to PostgreSQL (e.g. via `docker compose up -d`), uncomment below:
# DB_URL=jdbc:postgresql://localhost:5432/rti_assist
# DB_DRIVER=org.postgresql.Driver
# DB_USER=postgres
# DB_PASSWORD=postgres

# Local file uploads directory (for RTI acknowledgments & reply PDFs)
UPLOAD_DIR=uploads

# Daily reminder scheduler cron expression (default 9:00 AM daily)
REMINDER_CRON=0 0 9 * * ?
