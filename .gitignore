# Environment files and secrets (NEVER COMMIT CREDENTIALS)
.env
**/.env
*.env
**/*.env
*.local
**/*.local
!.env.example
!**/.env.example

# Node dependencies and build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Java / Spring Boot build artifacts
target/
**/target/
*.class
**/*.class
!.mvn/wrapper/maven-wrapper.jar

# Logs
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Temporary & backup folders
*.tmp
*.bak
*.sw?
yash1.mp3
rti-assist-backend-node-backup/

