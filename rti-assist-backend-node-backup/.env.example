# ==============================================================================
# RTI ASSIST BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Frontend connects to http://localhost:8000/api by default)
PORT=8000

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API KEY
# ------------------------------------------------------------------------------
# Get your free key from: https://aistudio.google.com/app/apikey
# Paste your Gemini key below:
GEMINI_API_KEY=

# Preferred Gemini Model (Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# JWT Secret for Token Verification
JWT_SECRET=rti_assist_jwt_dev_secret_key_2026

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
